{
    "name": "polify",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "scripts": {
        "dev": "vite --host",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "lint": "eslint . && pnpm lint:fallow",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow architecture --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "format": "prettier --write src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "verify": "pnpm type-check && pnpm lint && pnpm coverage",
        "hooks:install": "fallow hooks install --target git"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@vueuse/core": "^15.0.0",
        "d3": "^7.9.2",
        "d3-hexbin": "^0.2.2",
        "d3-scale-chromatic": "^3.1.1",
        "daisyui": "^5.8.0",
        "lz-string": "^1.5.0",
        "tailwindcss": "^4.3.5",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tsconfig/node22": "^22.0.7",
        "@types/d3": "^7.4.3",
        "@types/d3-hexbin": "^0.2.5",
        "@types/d3-scale-chromatic": "^3.1.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "fallow": "^3.43.0",
        "jsdom": "^31.0.1",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.10.1",
        "typescript": "~5.9.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
